# Base URL of the FastAPI backend. Leave empty for same-origin, which is how
# the production build is served (app.py serves static/dashboard/ at /) and how
# the Vite dev server works (see the proxy in vite.config.js).
VITE_API_URL=

# Twilio WhatsApp business number in E.164 digits, no "+" (e.g. 14155238886).
# Used to build the pre-filled wa.me link that arms a price alert. When unset,
# the alert dialog falls back to copy-the-message instructions.
VITE_WHATSAPP_NUMBER=
